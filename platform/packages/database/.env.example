# Database connection URL for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/gaming_platform?schema=public"

# Individual connection parameters (used by getDatabaseConfig())
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gaming_platform
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=5000

# Prisma logging
PRISMA_LOG_QUERIES=false
