# ==============================================
# Gaming Platform - Environment Variables
# ==============================================
# Copy this file to .env and fill in the values
# Do NOT commit .env to version control

# Database
DATABASE_URL=postgresql://gaming_platform:dev_password_123@localhost:5432/gaming_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://gaming_platform:dev_password_123@localhost:5672

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT Authentication
JWT_SECRET=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Services
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-xxx
GOOGLE_ANALYTICS_ID=G-xxx
GOOGLE_SEARCH_CONSOLE_KEY=xxx

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@gameplatform.com

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# App Configuration
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
